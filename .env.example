# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ops_portal

# AI Gateway (optional — for AI report generation)
# Compatible with any OpenAI-compatible LLM gateway
AI_GATEWAY_BASE_URL=https://your-llm-provider.example.com
AI_GATEWAY_TOKEN=
AI_DEFAULT_MODEL=gpt-4.1-mini

# Workbook ingestion (optional)
WORKBOOK_SOURCE_PATH=/path/to/your/workbook.xlsx
